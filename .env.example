# Copie para .env (backend) ou frontend/.env.local. Nunca commite valores reais.
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Pluggy (sem chave: MockPluggyAdapter)
PLUGGY_API_KEY=
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai

# Jev AI (sem chave: fallback)
JEV_AI_BASE_URL=
JEV_AI_API_KEY=
JEV_AI_MODEL=deepseek-v4.1-flash
JEV_AI_PROVIDER=
JEV_AI_SESSION=
JEV_AI_TIMEOUT=75

# Backend
FLASK_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost,capacitor://localhost
PUBLIC_SITE_URL=https://vivafinancas.vercel.app
DEMO_FAMILY_ID=eeeeeeee-0000-4000-8000-000000000001
SEED_DIR=backend/seed

# Frontend
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:5000/api
