# Copie para .env.local. Nunca commite valores reais.
# A anon key é pública; a service role nunca entra no frontend.
# Sem VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY o build compila, mas não
# autentica nem fala com o Supabase: não é artefato de deploy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:5000/api
