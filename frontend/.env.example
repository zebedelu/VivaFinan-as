# Copie para .env.local (dev). Nunca commite valores reais.
# A anon key é pública; a service role nunca entra no frontend.
# Sem VITE_SUPABASE_URL e VITE_SUPABASE_ANON_KEY o app compila, mas não
# autentica nem fala com o Supabase: não é artefato de deploy.
# Build de deploy (Vercel/CI) falha com o guard de `vite.config.js` se alguma
# das três VITE_* abaixo faltar; VITE_ENV_GUARD=strict força no build local.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Dev contra o Flask local. No build web o `.env.production` sobrescreve com /api.
VITE_API_URL=http://localhost:5000/api
# Atalhos de demo (login e restaurar): desligado por padrão; `true` só em local/E2E.
VITE_SHOW_DEMO_LOGIN=
