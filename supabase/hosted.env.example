# Copie para %USERPROFILE%\.config\vivafinancas\hosted.env e preencha.
# O arquivo real fica fora do repositorio e nunca deve ser commitado.
#
# Obrigatorias para o caminho CLI opcional. O caminho MCP atual usa apenas
# SUPABASE_PROJECT_REF, SUPABASE_URL e SUPABASE_ANON_KEY.

SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
VIVAFINANCAS_DEV_PROJECT_REF=
VIVAFINANCAS_ALLOW_REMOTE_RESET=no
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
